# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase --------------------------------------------------------
# Project URL and anon key are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
# Never import this into any file that ships to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---------------------------------------------------------------
# Public base URL of this deployment, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Used to sign webhook payloads (HMAC-SHA256) and other internal secrets.
APP_SECRET=

# --- Email (Resend) ------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="FormCraft <notifications@yourdomain.com>"

# --- AI (Anthropic) -------------------------------------------------------
# Optional. Enables "Describe a rule" and "Generate a form". Server-only:
# never prefix with NEXT_PUBLIC_. Without it those features say they're off.
ANTHROPIC_API_KEY=

# --- Custom domains (Phase 2, P2.2) --------------------------------------
# The host customers point their CNAME at (defaults to NEXT_PUBLIC_APP_URL's host).
CUSTOM_DOMAIN_CNAME_TARGET=
# Extra hostnames that are FormCraft itself (comma-separated), so they're
# never treated as a customer's domain. localhost, *.vercel.app and the
# NEXT_PUBLIC_APP_URL host are already included.
APP_HOSTS=
# Optional: let the app add verified domains to the Vercel project (which
# issues their TLS certificates). Without these, add domains on the host.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Tests only -------------------------------------------------------------
# Point the app at fake Stripe / HubSpot / Airtable APIs (E2E sets
# STRIPE_API_BASE and AIRTABLE_API_BASE).
# Leave unset in real deployments.
# STRIPE_API_BASE=
# HUBSPOT_API_BASE=
# AIRTABLE_API_BASE=
# Razorpay's API and its Checkout script (E2E serves stand-ins for both).
# RAZORPAY_API_BASE=
# RAZORPAY_CHECKOUT_SCRIPT=

# --- Product analytics (PostHog) ------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_SERVER_API_KEY=

# --- Error monitoring (Sentry) --------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Google Sheets integration (OAuth) -----------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Google Calendar for bookings (master spec F-43) uses the same Google
# OAuth client; register this second redirect URI on it too:
#   ${NEXT_PUBLIC_APP_URL}/api/connectors/oauth/callback
# and enable the Google Calendar API. The connectors cron
# (/api/cron/connectors) runs daily on Vercel's plan limits; call it more
# often (every 5–15 minutes) from any scheduler for prompt reminders,
# retries and calendar sync: POST with "Authorization: Bearer $CRON_SECRET".

# Business apps (master spec Phase 6). Each needs an OAuth app registered
# with the provider, with this redirect URI:
#   ${NEXT_PUBLIC_APP_URL}/api/connectors/oauth/callback
# An app without both values isn't offered. Tokens are encrypted with
# APP_SECRET. Syncs run on submit; the connectors cron retries them.
# Airtable: scopes data.records:write, schema.bases:read.
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
# Salesforce: a Connected App with scopes "api" and "refresh_token".
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Notion: a public integration (capabilities: read, update, insert content).
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=
# Zoho CRM: a server-based client in the US data centre (accounts.zoho.com).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=

# --- Keys (hardening, 2026-11-03) ----------------------------------------
# Encryption of stored secrets (provider keys, OAuth tokens, lookup
# headers), separate from APP_SECRET so it can be rotated:
#   id:base64(32 bytes)[,id:base64…] — the first key encrypts, all decrypt.
# Generate one: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
# To rotate: put a new key first, run `npm run secrets:reencrypt`, then
# remove the old one. Unset: a key derived from APP_SECRET (id "app").
ENCRYPTION_KEYS=

# --- Upload scanning (hardening, 2026-11-03) -----------------------------
# A ClamAV daemon (clamd) to scan respondent uploads before they're
# stored. Set it and infected files are refused — and so are files when
# clamd can't be reached. Unset: uploads aren't scanned.
# CLAMD_HOST=
# CLAMD_PORT=3310

# --- Rate limiting / abuse -------------------------------------------------
# How to find a visitor's address for per-IP limits. X-Forwarded-For's
# first entry is written by the visitor, so it is NOT trusted. Default:
# the entry our nearest proxy added (right-most). If your host sets its
# own client-address header, name it here (e.g. x-vercel-forwarded-for,
# cf-connecting-ip, fly-client-ip); if there are N proxies in front of
# the app, set TRUSTED_PROXY_HOPS=N. Leave both blank on Vercel.
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=
# Optional: only needed if a hosted rate-limit store (e.g. Upstash) is
# introduced; leave blank to use the in-memory/Postgres-backed limiter.
RATE_LIMIT_KV_URL=
RATE_LIMIT_KV_TOKEN=

# --- CAPTCHA (Cloudflare Turnstile, optional) -------------------------------
# Lets creators require a CAPTCHA on a form (Settings → Spam protection).
# Without both keys the switch stays off. A form that requires it refuses
# submissions the server can't verify (it never skips the check).
# Create a widget at dash.cloudflare.com → Turnstile; add your form hosts
# (including custom domains) to it. For local testing Cloudflare publishes
# always-pass keys: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cron (webhook retry sweep) ---------------------------------------------
# Shared secret an external scheduler (e.g. Vercel Cron) sends as
# "Authorization: Bearer <this>" to POST /api/cron/webhooks/dispatch.
# Generate with: openssl rand -hex 32
CRON_SECRET=
